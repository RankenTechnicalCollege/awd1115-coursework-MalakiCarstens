@model IEnumerable<FandomFinds.Models.ProductInformation>

<h2>Product Production Information</h2>

<a asp-area="Admin" asp-controller="ProductInformation" asp-action="AddEdit" class="btn btn-primary">Add New Product Info</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product</th>
           
            <th>Production Standards</th>
            <th>Safety Information</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product.Name</td>
                
                <td>@item.Information.ProductionStandards</td>
                <td>@item.Information.SafetyInformation</td>

                <td>
                   <a asp-action="Delete"
                       asp-route-productId="@item.ProductId"
                      asp-route-informationId="@item.InformationId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

